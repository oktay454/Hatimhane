# Mevcut HTTPS server bloğunuzda. Nginx Basic Auth kullanılmaz.
# TLS sertifikası ve alan adı ayarları sizin mevcut kurulumunuzda kalır.
location / {
	proxy_pass http://127.0.0.1:8787;
	proxy_set_header Host $host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header Authorization "";
	proxy_cache off;
	client_max_body_size 16k;
	proxy_connect_timeout 3s;
	proxy_read_timeout 30s;
}
# HTTP sunucusunda HTTPS'e yönlendirme yapın.
# Uygulama güvenlik başlıklarını kendi yanıtlarında gönderir.
# Eski CSP/Basic Auth konumlarını birlikte kullanmayın.
